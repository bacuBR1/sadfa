<div class="container">

  <h1 class="center-align">
    Ficha Técnica - {{filme.nome}}
  </h1>

  <div class="center-align">
    <a href="/filmes" class="btn grey">
      Voltar para filmes
    </a>
  </div>

  <hr>

  <form action="/filmes/{{filme.id}}/ficha-tecnica" method="POST">

    <div class="input-field">
      <input id="duracaoMinutos" type="number" name="duracaoMinutos">
      <label for="duracaoMinutos">Duração (minutos)</label>
    </div>

    <div class="input-field">
      <input id="orcamento" type="number" step="0.01" name="orcamento">
      <label for="orcamento">Orçamento</label>
    </div>

    <div class="input-field">
      <input id="bilheteria" type="number" step="0.01" name="bilheteria">
      <label for="bilheteria">Bilheteria</label>
    </div>

    <button type="submit" class="btn waves-effect waves-light">
      Salvar
    </button>

  </form>

</div>

