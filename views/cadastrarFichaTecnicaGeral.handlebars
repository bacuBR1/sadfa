<div class="container">

  <h1 class="center-align">Cadastrar Ficha Técnica</h1>

  <p class="center-align">
    <a href="/fichas-tecnicas" class="btn grey">
      Voltar para fichas técnicas
    </a>
  </p>

  <hr>

  {{#if filmes.length}}

    <form action="/fichas-tecnicas" method="POST">

      <div class="input-field">
        <select id="filmeId" name="filmeId" required>
          {{#each filmes}}
            <option value="{{this.id}}">
              {{this.nome}} ({{this.ano}})
            </option>
          {{/each}}
        </select>
        <label for="filmeId">Filme</label>
      </div>

      <div class="input-field">
        <input id="duracaoMinutos" type="number" name="duracaoMinutos" min="1">
        <label for="duracaoMinutos">Duração (minutos)</label>
      </div>

      <div class="input-field">
        <input id="orcamento" type="number" name="orcamento" min="0" step="0.01">
        <label for="orcamento">Orçamento</label>
      </div>

      <div class="input-field">
        <input id="bilheteria" type="number" name="bilheteria" min="0" step="0.01">
        <label for="bilheteria">Bilheteria</label>
      </div>

      <button type="submit" class="btn waves-effect waves-light">
        Cadastrar
      </button>

    </form>

  {{else}}

    <div class="card-panel yellow lighten-4">
      Cadastre um filme antes de criar uma ficha técnica.
      <br><br>
      <a href="/filmes/cadastrar" class="btn">
        Cadastrar filme
      </a>
    </div>

  {{/if}}

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var selects = document.querySelectorAll('select');
    M.FormSelect.init(selects);
  });
</script>