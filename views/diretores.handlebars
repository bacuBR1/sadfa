<div class="container">

  <h1 class="center-align">Lista de Diretores</h1>

  <div class="center-align">
    <a href="/" class="btn grey">
      Início
    </a>

    <a href="/diretores/cadastrar" class="btn waves-effect waves-light">
      Cadastrar diretor
    </a>
  </div>

  <br>

  {{#if diretores.length}}


      {{#each diretores}}

        <div class="col s12 m6 l4">

          <div class="card">

            <div class="card-content">

              <span class="card-title">
                {{this.nome}}
              </span>

              {{#if this.nacionalidade}}
                <p>
                  Nacionalidade: {{this.nacionalidade}}
                </p>
              {{/if}}

            </div>

            <div class="card-action">

<button>
              <a href="/diretores/{{this.id}}">
                Detalhar
              </a>
</button>

            </div>

          </div>

        </div>

      {{/each}}


  {{else}}

    <div class="card-panel yellow lighten-4 center-align">
      Nenhum diretor cadastrado.
    </div>

  {{/if}}

</div>
