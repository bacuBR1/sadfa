<div class="container">

  <h1 class="center-align">Detalhes do Artista</h1>

  <div class="center-align">
    <a href="/artistas" class="btn grey">
      Voltar para artistas
    </a>
  </div>

  <hr>

  <div class="card">
    <div class="card-content">

      <span class="card-title">
        Informações do Artista
      </span>

      <p>
        <strong>Nome:</strong>
        {{artista.nome}}
      </p>

      <p>
        <strong>Nome artístico:</strong>
        {{#if artista.nomeArtistico}}
          {{artista.nomeArtistico}}
        {{else}}
          Não informado
        {{/if}}
      </p>

      <p>
        <strong>Ano de nascimento:</strong>
        {{#if artista.anoNascimento}}
          {{artista.anoNascimento}}
        {{else}}
          Não informado
        {{/if}}
      </p>

      <p>
        <strong>Em atividade:</strong>
        {{#if artista.emAtividade}}
          Sim
        {{else}}
          Não
        {{/if}}
      </p>

      <p>
        <strong>Foto:</strong>
        {{#if artista.foto}}
          <a href="{{artista.foto}}" target="_blank">
            Ver foto
          </a>
        {{else}}
          Não informada
        {{/if}}
      </p>

    </div>
  </div>

  <h2 class="center-align">Filmes</h2>

  {{#if artista.filmes.length}}

    <div class="collection">

      {{#each artista.filmes}}

        <a
          href="/filmes/{{this.id}}"
          class="collection-item"
        >
          {{this.nome}} ({{this.ano}})
        </a>

      {{/each}}

    </div>

  {{else}}

    <div class="card-panel yellow lighten-4 center-align">
      Este artista ainda não está associado a filmes.
    </div>

  {{/if}}

</div>