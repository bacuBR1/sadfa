<div class="container">

  <h1 class="center-align">Cadastrar Filme</h1>

  <hr>

  <form action="/filmes" method="POST">

    <div class="input-field">
      <input type="text" name="nome" id="nome">
      <label for="nome">Nome do Filme</label>
    </div>

    <div class="input-field">
      <input type="number" name="ano" id="ano">
      <label for="ano">Ano</label>
    </div>

    <div class="input-field">
      <select id="diretorId" name="diretorId">
        <option value="" selected>Sem diretor</option>

        {{#each diretores}}
          <option value="{{this.id}}">{{this.nome}}</option>
        {{/each}}

      </select>
      <label for="diretorId">Diretor</label>
    </div>

    <div class="input-field">
      <select id="artistas" name="artistas" multiple>

        {{#each artistas}}
          <option value="{{this.id}}">{{this.nome}}</option>
        {{/each}}

      </select>

      <label for="artistas">Artistas</label>
    </div>

    <button class="btn waves-effect waves-light">
      Cadastrar
    </button>

  </form>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var selects = document.querySelectorAll('select');
    M.FormSelect.init(selects);
  });
</script>

<body>

<style>

.btn {
  background-color: #004aad;
  color: white;
  margin: 5px;
}



</style>



</body>