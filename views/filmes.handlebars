<h1>Lista de Filmes</h1>

<a href="/filmes/cadastrar">
  Cadastrar Filme
</a>

<hr>

<ul>

  {{#each filmes}}

    <li>
      {{this.nome}} - {{this.ano}} 

      <a href="/filmes/{{this.id}}/editar">Editar</a>
      
      <form action="/filmes/{{this.id}}?_method=DELETE" method="POST" style="display: inline;">
        <button type="submit">Excluir</button>
      </form>
    </li>

  {{/each}}

</ul>