<div class="container">

  <h1 class="center-align">Lista de Artistas</h1>

  <div class="center-align">
    <a href="/" class="btn grey">
      Início
    </a>

    <a href="/artistas/cadastrar" class="btn waves-effect waves-light">
      Cadastrar artista
    </a>
  </div>

  <br>

  {{#if artistas.length}}


    {{#each artistas}}

    <div class="col s12 m6 l4">

      <div class="card">

        <div class="card-content">

          <span class="card-title">
            {{this.nome}}
          </span>

          {{#if this.nomeArtistico}}
          <p>
            Nome artístico: {{this.nomeArtistico}}
          </p>
          {{/if}}

        </div>

        <div class="card-action">

          <a href="/artistas/{{this.id}}">
            Detalhar
          </a>

        </div>

      </div>

    </div>

    {{/each}}


  {{else}}

  <div class="card-panel yellow lighten-4 center-align">
    Nenhum artista cadastrado.
  </div>

  {{/if}}

</div>