<div class="container">

  <h1 class="center-align">Detalhes da Ficha Técnica</h1>

  <div class="center-align">
    <a href="/fichas-tecnicas" class="btn grey">
      Voltar para fichas técnicas
    </a>
  </div>

  <br>

  <div class="card">

    <div class="card-content">

      <span class="card-title">Informações da Ficha Técnica</span>

      <p><strong>Filme:</strong></p>

      <p>
        {{#if fichaTecnica.filme}}
          <a href="/filmes/{{fichaTecnica.filme.id}}">
            {{fichaTecnica.filme.nome}}
            ({{fichaTecnica.filme.ano}})
          </a>
        {{else}}
          Não informado
        {{/if}}
      </p>

      <br>

      <p>
        <strong>Duração:</strong>
        {{#if fichaTecnica.duracaoMinutos}}
          {{fichaTecnica.duracaoMinutos}} minutos
        {{else}}
          Não informada
        {{/if}}
      </p>

      <p>
        <strong>Orçamento:</strong>
        {{#if fichaTecnica.orcamento}}
          {{fichaTecnica.orcamento}}
        {{else}}
          Não informado
        {{/if}}
      </p>

      <p>
        <strong>Bilheteria:</strong>
        {{#if fichaTecnica.bilheteria}}
          {{fichaTecnica.bilheteria}}
        {{else}}
          Não informada
        {{/if}}
      </p>

    </div>

  </div>

</div>