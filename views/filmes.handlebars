<div class="container">

  <h1 class="center-align">Lista de Filmes</h1>

  <div class="center-align">
    <a href="/filmes/cadastrar" class="btn waves-effect waves-light">
      Cadastrar Filme
    </a>
  </div>

  <br>


  {{#each filmes}}

  <div class="col s12 m6 l4">

    <div class="card">

      <div class="card-content">
        <span class="card-title">{{this.nome}}</span>

        <p>Ano: {{this.ano}}</p>
      </div>

      <div class="card-action">

       
          <a class="btn" href="/filmes/{{this.id}}/editar">
            Editar
          </a>
          
    <form action="/filmes/{{this.id}}?_method=DELETE" method="POST" >
        <button type="submit">
            Excluir
        </button>
    </form>


      </div>

    </div>

  </div>

  {{/each}}


</div>

<boby>

  <style>
    .btn {
      background-color: #004aad;
      color: white;
      padding: 2px 25px;
      text-decoration: none;
    }

    .card-action button {
      background-color: #004aad;
      text-decoration: none;
      color: white;
      position: relative;
      padding: 8px 25px;
      margin-left: 115px;
      top: -36px;

    }

  .btn a{
    color: white;
  }

    
  </style>
</boby>