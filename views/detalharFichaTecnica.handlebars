<h1>Detalhes da Ficha Técnica</h1>

<p><a href="/fichas-tecnicas">Voltar para fichas técnicas</a></p>

<dl>
  <dt>Filme</dt>
  <dd>
    {{#if fichaTecnica.filme}}
      <a href="/filmes/{{fichaTecnica.filme.id}}">{{fichaTecnica.filme.nome}} ({{fichaTecnica.filme.ano}})</a>
    {{else}}
      Não informado
    {{/if}}
  </dd>
  <dt>Duração</dt>
  <dd>{{#if fichaTecnica.duracaoMinutos}}{{fichaTecnica.duracaoMinutos}} minutos{{else}}Não informada{{/if}}</dd>
  <dt>Orçamento</dt>
  <dd>{{#if fichaTecnica.orcamento}}{{fichaTecnica.orcamento}}{{else}}Não informado{{/if}}</dd>
  <dt>Bilheteria</dt>
  <dd>{{#if fichaTecnica.bilheteria}}{{fichaTecnica.bilheteria}}{{else}}Não informada{{/if}}</dd>
</dl>