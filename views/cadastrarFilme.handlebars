<h1>Cadastrar Filme</h1>

<form action="/filmes" method="POST">

  <div>
    <label>Nome do Filme:</label>
    <input type="text" name="nome">
  </div>

  <br>

  <div>
    <label>Ano:</label>
    <input type="number" name="ano">
  </div>

  <br>

  <div>
    <label for="diretorId">Diretor:</label>
    <select id="diretorId" name="diretorId">
      <option value="">Sem diretor</option>
      {{#each diretores}}
        <option value="{{this.id}}">{{this.nome}}</option>
      {{/each}}
    </select>
  </div>

  <br>

  <div>
    <label for="artistas">Artistas:</label>
    <select id="artistas" name="artistas" multiple>
      {{#each artistas}}
        <option value="{{this.id}}">{{this.nome}}</option>
      {{/each}}
    </select>
  </div>

  <br>

  <button type="submit">
    Cadastrar
  </button>

</form>