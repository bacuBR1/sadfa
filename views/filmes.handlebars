<div class="container">

  <h1 class="center-align">Lista de Filmes</h1>

  <div class="center-align">
    <a href="/filmes/cadastrar" class="btn waves-effect waves-light">
      Cadastrar Filme
    </a>
  </div>

  <br>


    {{#each filmes}}

    <div class="col s12 m6 l4">

      <div class="card">

        <div class="card-content">
          <span class="card-title">{{this.nome}}</span>

          <p>Ano: {{this.ano}}</p>
        </div>

        <div class="card-action">
          
          <button>
            <a href="/filmes/{{this.id}}/editar">
              Editar
            </a>
          </button>

          <form action="/filmes/{{this.id}}?_method=DELETE" method="POST" style="display: inline;">
            <button type="submit">
              Excluir
            </button>
          </form>

        </div>

      </div>

    </div>

    {{/each}}


</div>