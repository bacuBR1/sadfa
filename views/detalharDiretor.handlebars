<div class="container">

  <h1 class="center-align">Detalhes do Diretor</h1>

  <div class="center-align">
    <a href="/diretores" class="btn grey">
      Voltar para diretores
    </a>
  </div>

  <hr>

  <div class="card">
    <div class="card-content">

      <span class="card-title">
        Informações do Diretor
      </span>

      <p>
        <strong>Nome:</strong>
        {{diretor.nome}}
      </p>

      <p>
        <strong>Ano de nascimento:</strong>
        {{#if diretor.anoNascimento}}
          {{diretor.anoNascimento}}
        {{else}}
          Não informado
        {{/if}}
      </p>

      <p>
        <strong>Nacionalidade:</strong>
        {{#if diretor.nacionalidade}}
          {{diretor.nacionalidade}}
        {{else}}
          Não informada
        {{/if}}
      </p>

    </div>
  </div>

  <h2 class="center-align">Filmes</h2>

  {{#if diretor.filmes.length}}

    <div class="collection">

      {{#each diretor.filmes}}

        <a
          href="/filmes/{{this.id}}"
          class="collection-item"
        >
          {{this.nome}} ({{this.ano}})
        </a>

      {{/each}}

    </div>

  {{else}}

    <div class="card-panel yellow lighten-4 center-align">
      Este diretor ainda não está associado a filmes.
    </div>

  {{/if}}

</div>