<div class="container">

  <h1 class="center-align">Cadastrar Diretor</h1>

  <div class="center-align">
    <a href="/diretores" class="btn grey">
      Voltar para diretores
    </a>
  </div>

  <hr>

  <form action="/diretores" method="POST">

    <div class="input-field">
      <input id="nome" type="text" name="nome" required>
      <label for="nome">Nome</label>
    </div>

    <div class="input-field">
      <input id="anoNascimento" type="number" name="anoNascimento">
      <label for="anoNascimento">Ano de nascimento</label>
    </div>

    <div class="input-field">
      <input id="nacionalidade" type="text" name="nacionalidade">
      <label for="nacionalidade">Nacionalidade</label>
    </div>

    <button type="submit" class="btn waves-effect waves-light">
      Cadastrar
    </button>

  </form>

</div>

