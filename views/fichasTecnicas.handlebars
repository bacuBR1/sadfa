<div class="container">

  <h1 class="center-align">Lista de Fichas Técnicas</h1>

  <div class="center-align">
    <a href="/" class="btn grey">
      Início
    </a>

    <a href="/fichas-tecnicas/cadastrar" class="btn waves-effect waves-light">
      Cadastrar ficha técnica
    </a>
  </div>

  <br>

  {{#if fichasTecnicas.length}}


      {{#each fichasTecnicas}}

        <div class="col s12 m6 l4">

          <div class="card">

            <div class="card-content">

              <span class="card-title">
                {{#if this.filme}}
                  {{this.filme.nome}}
                {{else}}
                  Filme não informado
                {{/if}}
              </span>

              <p>
                Ficha técnica do filme
              </p>

            </div>

            <div class="card-action">

<button>
              <a href="/fichas-tecnicas/{{this.id}}">
                Detalhar
              </a>
</button>

            </div>

          </div>

        </div>

      {{/each}}


  {{else}}

    <div class="card-panel yellow lighten-4 center-align">
      Nenhuma ficha técnica cadastrada.
    </div>

  {{/if}}

</div>

<body>

<style>


.center-align a {
  background-color: #004aad;
  color: white;
  margin: 5px;
}









</style>

</body>