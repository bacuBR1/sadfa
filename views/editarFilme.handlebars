<div class="container">

  <h1 class="center-align">Editar Filme</h1>

  <div class="center-align">
    <a href="/filmes" class="btn grey">
      Voltar para filmes
    </a>
  </div>

  <hr>

  <form action="/filmes/{{filme.id}}?_method=PUT" method="POST">

    <div class="input-field">
      <input
        id="nome"
        type="text"
        name="nome"
        value="{{filme.nome}}"
      >
      <label for="nome">Nome do Filme</label>
    </div>

    <div class="input-field">
      <input
        id="ano"
        type="number"
        name="ano"
        value="{{filme.ano}}"
      >
      <label for="ano">Ano</label>
    </div>

    <button type="submit" class="btn waves-effect waves-light">
      Editar
    </button>

  </form>

</div>
<body>

<style>

.btn{
  background-color: #004aad;

}



</style>




</body>